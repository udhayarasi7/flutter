rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      // Allow read access to all authenticated users
      allow read: if request.auth != null;
      
      // Allow write access only to the user's own document
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Notifications subcollection
      match /notifications/{notificationId} {
        // Allow read access to the user's own notifications
        allow read: if request.auth != null && request.auth.uid == userId;
        
        // Allow any authenticated user to create notifications for this user
        allow create: if request.auth != null;
        
        // Allow update and delete only by the notification owner
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Notifications collection for FCM (temporary storage)
    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null;
    }
    
    // Hospitals collection
    match /hospitals/{hospitalId} {
      // Allow read access to all authenticated users
      allow read: if request.auth != null;
      
      // Allow write access only to authenticated users
      allow write: if request.auth != null;
    }

    // Blood Centers collection
    match /bloodCenters/{centerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Blood Bank collection
    match /blood_bank/{bankId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
